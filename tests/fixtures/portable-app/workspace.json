{
  "package.json": {
    "name": "harbor-logistics",
    "private": true
  },
  "nx.json": {
    "defaultBase": "main",
    "namedInputs": {
      "default": ["{projectRoot}/**/*", "shared"],
      "shared": ["{workspaceRoot}/pipeline/**/*"]
    },
    "targetDefaults": {
      "container": {
        "inputs": ["default", "^default"]
      },
      "build": {
        "inputs": ["default", "^default"]
      },
      "chart-package": {
        "inputs": ["default", "^default"]
      }
    }
  },
  "modules/rates/project.json": {
    "name": "pricing-core",
    "targets": {
      "build": {
        "command": "echo build rates"
      },
      "build": {
        "command": "echo publish rates"
      }
    }
  },
  "services/booking/project.json": {
    "name": "booking-api",
    "implicitDependencies": ["pricing-core"],
    "targets": {
      "container": {
        "command": "echo image"
      }
    }
  },
  "services/tracking/project.json": {
    "name": "tracking-api",
    "targets": {
      "container": {
        "command": "echo image"
      }
    }
  },
  "deploy/shared/project.json": {
    "name": "harbor-chart",
    "targets": {
      "chart-package": {
        "command": "echo chart"
      }
    }
  },
  "modules/rates/source.txt": "initial rates",
  "services/booking/source.txt": "initial booking",
  "services/tracking/source.txt": "initial tracking",
  "deploy/shared/values.yaml": "initial chart",
  "pipeline/settings.json": "{}",
  "README.md": "Harbor logistics fixture"
}
