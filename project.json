{
  "tags": ["type:maven-parent"],
  "targets": {
    "java-verify": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/pom.xml",
        "{workspaceRoot}/.mvn/**/*",
        "{workspaceRoot}/mvnw",
        "{workspaceRoot}/apps/*/pom.xml",
        "{workspaceRoot}/apps/*/src/**/*",
        "{workspaceRoot}/libraries/*/pom.xml",
        "{workspaceRoot}/libraries/*/src/**/*",
        "{workspaceRoot}/tools/pipeline/config.json",
        "{workspaceRoot}/nx.json"
      ],
      "outputs": [
        "{workspaceRoot}/apps/*/target",
        "{workspaceRoot}/libraries/*/target"
      ],
      "options": {
        "command": "./mvnw -B -ntp verify"
      }
    }
  }
}
