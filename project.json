{
  "tags": ["type:maven-parent"],
  "targets": {
    "java-verify": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "{projectRoot}/pom.xml",
        "{projectRoot}/.mvn/**/*",
        "{projectRoot}/mvnw",
        "{projectRoot}/nx.json",
        "{projectRoot}/.github/workflows/ci.yml",
        "{projectRoot}/compose.yaml"
      ],
      "outputs": [
        "{workspaceRoot}/apps/*/target",
        "{workspaceRoot}/libraries/*/target"
      ],
      "options": {
        "command": "./mvnw -B -ntp verify"
      }
    },
    "ci": {
      "executor": "nx:run-commands",
      "cache": false,
      "metadata": {
        "description": "Test - Workspace and dependency graph"
      },
      "options": {
        "command": "npm run test:workspace"
      }
    }
  }
}
