{
  "name": "fieldsignal",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/station-console",
    "apps/operator-console",
    "libraries/ui"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build --workspace @fieldsignal/ui && npm run build --workspace @fieldsignal/station-console && npm run build --workspace @fieldsignal/operator-console",
    "dev:stations": "npm run dev --workspace @fieldsignal/station-console",
    "dev:operations": "npm run dev --workspace @fieldsignal/operator-console",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "@vitejs/plugin-react": "6.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^26.6.6"
  }
}
