{
  "name": "fieldsignal",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "libraries/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "nx run-many -t build mvn-package",
    "dev:stations": "npm run dev --workspace @fieldsignal/station-console",
    "dev:operations": "npm run dev --workspace @fieldsignal/operator-console",
    "typecheck": "nx run-many -t typecheck",
    "test:workspace": "node --test tests/workspace.test.mjs",
    "test:functional": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@nx/js": "24.0.6",
    "@nx/maven": "24.0.6",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "nx": "24.0.6",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.7",
    "yaml": "2.8.1"
  },
  "nx": {
    "includedScripts": []
  }
}
