{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "neverConnectToCloud": true,
  "defaultBase": "main",
  "plugins": [
    {
      "plugin": "@nx/maven",
      "options": {
        "targetNamePrefix": "mvn-"
      }
    }
  ],
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/package-lock.json",
      "{workspaceRoot}/tsconfig.json",
      "{workspaceRoot}/.mvn/**/*",
      "{workspaceRoot}/.github/workflows/**/*",
      "{workspaceRoot}/.dockerignore",
      "{workspaceRoot}/.github/actions/**/*",
      "{workspaceRoot}/tools/pipeline/**/*",
      "{workspaceRoot}/tools/publish-maven.sh"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "mvn-package": {
      "cache": true
    },
    "container": {
      "inputs": ["default", "^default"]
    },
    "publish-maven": {
      "inputs": ["default", "^default"]
    },
    "chart-package": {
      "inputs": ["default", "^default"]
    },
    "mvn-verify": {
      "inputs": ["default", "^default"]
    }
  }
}
